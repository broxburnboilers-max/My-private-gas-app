{
  "name": "Gas Safety – West Lothian Gas Ltd",
  "short_name": "Gas App",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#2a52d4",
  "theme_color": "#2a52d4",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "/share-contact",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        { "name": "contact", "accept": ["text/vcard", "text/x-vcard", "text/directory", ".vcf", "text/plain"] }
      ]
    }
  }
}
